{
  "schema": 1,
  "project": {
    "schema": 1,
    "projectId": "just-every/pegboard",
    "name": "Pegboard",
    "sourceRepository": "https://github.com/just-every/run-pegboard",
    "license": "MIT",
    "deployment": {
      "target": "cloudflare-workers",
      "artifactFile": "rer-worker-artifact.json"
    },
    "operations": {
      "setup": "pnpm install --frozen-lockfile",
      "build": "pnpm run build",
      "verify": "pnpm run verify && pnpm run check:deployment-spec",
      "artifact": "pnpm run delivery:artifact",
      "recovery": "Follow OPERATIONS.md: stop writes and scheduled work, retain the exact source and private configuration, export the supported installation data, restore into an empty installation, run owner setup and compare a fresh export before routing traffic. Preserve every applied migration name and byte."
    },
    "verification": {
      "migrationDirectories": [
        "migrations/core"
      ],
      "guidanceFiles": [
        "AGENTS.md",
        "OPERATIONS.md",
        "CONTRACT.md"
      ],
      "testPatterns": [
        "tests/**/*.mjs"
      ]
    }
  },
  "managed": {
    "workflowRef": "runeditrun/delivery/.github/workflows/trusted-build.yml@34cf6c23b5cb86eff0068049bc39feeb38c8ffa9",
    "artifactFile": "rer-worker-artifact.json",
    "buildProfile": "project",
    "verificationProfiles": [
      "full"
    ]
  },
  "artifact": {
    "specInputs": {
      "publicVariableNames": [
        "AUTH_ORIGIN",
        "AUTH_LOCAL",
        "OWNER_EMAIL",
        "IDENTITY_PROVIDER",
        "MAIL_PROVIDER",
        "MAIL_FROM",
        "MAIL_RELAY_URL",
        "MAIL_ACCOUNT_ID"
      ],
      "secretNames": [
        "SESSION_SECRET",
        "SETUP_TOKEN",
        "INSTALLATION_KEY"
      ],
      "optionalSecretNames": [
        "MAIL_API_KEY"
      ],
      "healthPath": "/health",
      "recovery": "Follow OPERATIONS.md: stop writes and scheduled work, retain the exact source and private configuration, export the supported installation data, restore into an empty installation, run owner setup and compare a fresh export before routing traffic. Preserve every applied migration name and byte.",
      "providerEffects": [
        "outbound-mail"
      ],
      "mail": {
        "providers": [
          "rer",
          "resend",
          "sendgrid",
          "cloudflare"
        ]
      },
      "surfaces": {
        "app": {
          "path": "/",
          "originVariable": "AUTH_ORIGIN",
          "signIn": {
            "path": "/signin",
            "loginHint": false,
            "ownerSignIn": "/auth/owner-signin"
          }
        }
      }
    }
  },
  "setup": {
    "manifestFile": "rer-setup.json"
  },
  "edition": {
    "manifestFile": "edition.json",
    "componentId": "just-every/pegboard"
  }
}
